extends SceneTree
const Fixture := preload("res://tests/fixtures/item_tool_fixture.gd")
const Water := preload("res://src/world/water_map.gd")
var failures := 0
func check(value: bool, label: String) -> void:
	if not value:
		failures += 1
		print("FAIL: ", label)
func _initialize() -> void: call_deferred("run")
func command(sim, action: String, cell: Vector2i) -> Dictionary:
	return sim.execute_farming_command({"actor_id": "core:player", "action_id": action, "cell": [cell.x, cell.y]})
func run() -> void:
	var sim := Fixture.world()
	var soil := Vector2i(18,29)
	sim.set_player_position(sim.content.cell_center(soil.x, soil.y))
	check(sim.try_pickup_item("test:hoe_variant", 1).success, "Fixture hoe fits")
	sim.select_inventory_item("test:hoe_variant", sim.get_inventory_instance_id("test:hoe_variant", 0))
	check(command(sim, "till", soil).success, "Variant hoe tills real soil")
	check(sim.try_pickup_item("test:bucket_variant", 1).success, "Fixture bucket fits")
	var id := sim.get_inventory_instance_id("test:bucket_variant", 0)
	sim.assign_hotbar_slot(0, id)
	sim.select_hotbar_slot(0)
	var bank: Vector2i = Water.surface_cells()[0]
	sim.set_player_position(sim.content.cell_center(bank.x, bank.y))
	check(sim.fill_active_bucket(bank).success and int(sim.get_item_instance(id).state.get("charges", 0)) == 4, "Variant fills four charges")
	if failures > 0:
		finish()
		return
	sim.set_player_position(sim.content.cell_center(soil.x, soil.y))
	check(command(sim, "water", soil).success and sim.get_item_instance(id).state.charges == 3, "One water charge consumed")
	check(sim.get_farm_bed(soil).wet_until == sim.get_elapsed_game_minutes() + 1440, "Literal wet duration preserved")
	var before := sim.export_state()
	check(not command(sim, "water", soil).success and sim.export_state() == before, "Wet refusal preserves all state")
	sim.set_player_position(Vector2.ZERO)
	before = sim.export_state()
	check(not sim.fill_active_bucket(bank).success and sim.export_state() == before, "Distant fill preserves state")
	var restored := Fixture.world(JSON.parse_string(JSON.stringify(sim.export_state())))
	check(restored.state.version == restored.SAVE_VERSION and restored.get_active_item_instance().instance_id == id and restored.get_item_instance(id).state.charges == 3, "Current save retains exact instance and water")
	var normalizer = load("res://src/items/tool_instance_state.gd")
	for raw: Variant in [null, "3", true, 1.5, NAN, INF]:
		check(normalizer.normalize_water_state({"charges": raw, "other": 7}, 4) == {"charges": 0, "other": 7}, "Invalid charge becomes zero; unrelated state retained")
	check(normalizer.normalize_water_state({"charges": 100}, 4).charges == 4, "Capacity upper clamp")
	check(normalizer.normalize_water_state({"charges": -2}, 4).charges == 0, "Capacity lower clamp")
	check(normalizer.normalize_water_state({}, 16).charges == 0, "Missing charge")
	check(normalizer.normalize_water_state({"charges": 16.0}, 16).charges == 16, "JSON whole number retained")
	var old := Fixture.world()
	old.try_pickup_item("core:bucket", 1)
	var old_id := old.get_inventory_instance_id("core:bucket", 0)
	old.select_inventory_item("core:bucket", old_id)
	old.set_player_position(old.content.cell_center(bank.x, bank.y))
	check(old.fill_active_bucket(bank).success and old.get_item_instance(old_id).state.charges == 2, "Old capacity remains two")
	old.state.farming.beds.append({"cell": [18,29], "crop_id": "", "growth": 0, "wet_until": 0, "last_update": old.get_elapsed_game_minutes(), "harvests": 0})
	old.set_player_position(old.content.cell_center(18,29))
	check(command(old, "water", soil).success and old.get_item_instance(old_id).state.charges == 1, "Old watering remains 2 -> 1")
	var copies := Fixture.world()
	var ids := copies._create_item_instances("test:bucket_variant", 2, "inventory", "", {"charges": 99, "other": 7})
	check(copies.get_item_instance(ids[0]).state == {"charges": 4, "other": 7}, "Physical creation uses shared normalizer")
	copies._update_instance_state(ids[0], {"charges": 1})
	check(copies.get_item_instance(ids[1]).state.charges == 4, "Each physical copy has separate charges")
	copies._update_instance_state(ids[0], {"charges": "3", "other": 9})
	var loaded := Fixture.world(JSON.parse_string(JSON.stringify(copies.export_state())))
	check(loaded.get_item_instance(ids[0]).state.charges == 0 and loaded.get_item_instance(ids[0]).state.other == 9, "Actual reload normalizes invalid charges: " + str(loaded.get_item_instance(ids[0])))
	loaded.select_inventory_item("test:bucket_variant", ids[0])
	loaded.state.farming.beds.append({"cell": [18,29], "crop_id": "", "growth": 0, "wet_until": 0, "last_update": 0, "harvests": 0})
	loaded.set_player_position(loaded.content.cell_center(18,29))
	before = loaded.export_state()
	check(not command(loaded, "water", soil).success and loaded.export_state() == before, "Empty physical bucket refuses unchanged")
	finish()
func finish() -> void:
	print("ITEM_TOOL_WATER: %d failures" % failures)
	quit(0 if failures == 0 else 1)
