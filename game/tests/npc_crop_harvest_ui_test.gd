extends "res://tests/package_d_meeting_ui_test.gd"
const Lab := preload("res://src/dev/mechanics_lab.tscn")
func _ready() -> void:
	get_tree().create_timer(45).timeout.connect(func() -> void: get_tree().quit(1))
	TranslationServer.set_locale("ru")
	var lab := Lab.instantiate()
	add_child(lab)
	await frames()
	lab._load_scenario(&"shared_crop_harvest")
	await frames()
	check(Session.is_paused() and Session.is_mechanics_lab_active(),"Harvest lab is paused and save-blocked")
	check(String(lab._description_label.text).contains("Искусственный"),"Lab labels prepared crop state as synthetic")
	var sim = Session.simulation
	var beds: Array = sim.get_farm_beds()
	check(beds.size()==3 and not bool(beds[0].shared_harvest),"Synthetic lab contains an explicit personal crop")
	var game = lab.get_node("Game")
	game.get_node("Player").set_physics_process(false)
	var hud = game.get_node("Hud/HudRoot")
	lab._set_lab_panel_open(false)
	var cell := Vector2i(int(beds[0].cell[0]),int(beds[0].cell[1]))
	sim.set_player_position(sim.content.cell_center(cell.x,cell.y))
	hud.open_farming(cell)
	await frames()
	var permission = hud._farming_panel.find_child("SharedHarvestPermission",true,false)
	check(permission!=null and permission.text=="Общий урожай","Shared crop checkbox is translated")
	if permission!=null:
		await click(permission)
		check(bool(sim.get_farm_bed(cell).shared_harvest),"Actual crop click authorizes shared harvest")
		permission = hud._farming_panel.find_child("SharedHarvestPermission",true,false)
		await click(permission)
		check(not bool(sim.get_farm_bed(cell).shared_harvest),"Actual second click restores personal crop")
	await screenshot("shared-crop-permission.png")
	hud._set_farming_open(false)
	hud.open_character_needs("core:first_neighbor")
	await frames()
	permission = hud._needs_panel.find_child("HarvestPermission",true,false)
	check(permission!=null and permission.text=="Сбор урожая","Resident harvest permission is translated")
	if permission!=null:
		var rect: Rect2 = hud._needs_panel.get_global_rect()
		check(rect.encloses(permission.get_global_rect()),"Permission fits inside resident panel")
		await click(permission)
		check(not bool(sim.state.npcs["core:first_neighbor"].work_options.harvest),"Actual resident click disables harvest")
		await click(permission)
		check(bool(sim.state.npcs["core:first_neighbor"].work_options.harvest),"Actual resident click enables harvest")
	await screenshot("resident-harvest-permission.png")
	hud._set_needs_open(false)
	sim.advance_minutes(120)
	check(String(sim.get_farm_bed(cell).crop_id)=="carrot","Ordinary NPC time leaves personal carrot untouched")
	check(sim.StockReserves.total(sim,"core:potato")>0,"Ordinary NPC time delivers public potatoes")
	lab._set_lab_panel_open(true)
	await frames()
	await screenshot("shared-harvest-laboratory.png")
	print("PASS: actual harvest UI, ordinary lab work and screenshots" if failures==0 else "FAIL: harvest UI")
	get_tree().quit(0 if failures==0 else 1)
